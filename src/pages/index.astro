---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../lib/categories';

const reports = await getCollection('reports');
const counts = new Map<string, number>();
for (const r of reports) {
  const key = r.id.split('/')[0];
  counts.set(key, (counts.get(key) ?? 0) + 1);
}
const volumes = CATEGORIES.filter((c) => (counts.get(c.key) ?? 0) > 0);
---
<Base title="Canonreeve Archives">
  <main class="hall">
    <header class="masthead">
      <p class="over">Thalmor Embassy &mdash; Skyrim</p>
      <h1>Canonreeve Archives</h1>
      <div class="ornament" aria-hidden="true">
        <svg width="26" height="10" viewBox="0 0 26 10" fill="currentColor"><path d="M13 0l3.2 5L13 10 9.8 5 13 0zm-9 3.4L6.4 5 4 6.6 1.6 5 4 3.4zm18 0L24.4 5 22 6.6 19.6 5 22 3.4z"/></svg>
      </div>
      <p class="lede">The filed record of Canonreeve Ancarion Saelthar, bound by volume.</p>
    </header>

    <div class="shelf" role="list" aria-label="Archive volumes">
      {volumes.map((v) => (
        <a class="volume" role="listitem" href={`${import.meta.env.BASE_URL}category/${v.key}/`} style={`--spine:${v.spine}`}>
          <span class="cover">
            {v.img
              ? <img class="glyph glyph-img" src={`${import.meta.env.BASE_URL}icons/${v.img}`} alt="" loading="lazy" />
              : <span class="glyph" set:html={v.icon} />}
            <span class="vlabel" set:html={v.label} />
          </span>
          <span class="count">{counts.get(v.key)} filed</span>
        </a>
      ))}
    </div>

    <footer class="colophon">Filed and bound by order of the Canonreeve.</footer>
  </main>
</Base>

<style>
  .hall {
    min-height: 100vh;
    display: flex; flex-direction: column; align-items: center;
    gap: 2.4rem;
    padding: clamp(2.4rem, 6vw, 4rem) 1.2rem 3rem;
  }
  .masthead { text-align: center; max-width: 640px; }
  .over {
    font-family: var(--font-caps); letter-spacing: .3em; font-size: .8rem;
    color: var(--parchment-edge); margin: 0 0 .4rem;
  }
  h1 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.8rem, 4.5vw, 2.6rem); letter-spacing: .08em;
    margin: 0 0 .6rem; color: var(--parchment);
  }
  .ornament { justify-content: center; color: var(--gold); }
  .lede {
    margin: .9rem 0 0; color: var(--parchment-edge);
    font-style: italic; font-size: 1.02rem;
  }

  .shelf {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: clamp(1rem, 2.6vw, 1.8rem);
    max-width: 1100px;
    padding: 2rem clamp(1rem, 3vw, 2.4rem) 1.6rem;
    border-radius: 6px;
    background: linear-gradient(180deg, #241a10, #17110a 88%);
    box-shadow:
      inset 0 2px 0 rgba(255,255,255,.05),
      inset 0 -18px 26px -14px rgba(0,0,0,.7),
      0 20px 40px rgba(0,0,0,.55);
    border: 1px solid rgba(184,159,110,.18);
  }

  .volume {
    display: flex; flex-direction: column; align-items: center; gap: .55rem;
    text-decoration: none;
    width: clamp(120px, 22vw, 152px);
  }
  .cover {
    width: 100%; aspect-ratio: 3 / 4;
    border-radius: 3px 6px 6px 3px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .7rem; padding: 1rem .8rem;
    text-align: center;
    background:
      linear-gradient(155deg, rgba(255,255,255,.10), transparent 40%),
      var(--spine);
    box-shadow:
      inset 0 0 0 1px rgba(212,182,120,.28),
      inset 4px 0 0 rgba(0,0,0,.35),
      0 10px 18px rgba(0,0,0,.5);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .volume:hover .cover, .volume:focus-visible .cover {
    transform: translateY(-8px) rotate(-1deg);
    box-shadow:
      inset 0 0 0 1px rgba(212,182,120,.4),
      inset 4px 0 0 rgba(0,0,0,.35),
      0 18px 26px rgba(0,0,0,.6);
  }
  .glyph { width: 30%; color: var(--parchment-edge); opacity: .92; }
  .glyph :global(svg) { width: 100%; height: auto; display: block; }
  .glyph-img {
    width: 46%; height: 46%; object-fit: contain;
    opacity: 1; filter: drop-shadow(0 4px 6px rgba(0,0,0,.55));
  }
  .vlabel {
    font-family: var(--font-caps); letter-spacing: .06em;
    font-size: clamp(.78rem, 1.6vw, .92rem);
    line-height: 1.3; color: var(--parchment);
  }
  .count {
    font-family: var(--font-caps); letter-spacing: .12em;
    font-size: .74rem; color: var(--parchment-edge);
  }

  .colophon {
    text-align: center; font-style: italic;
    color: var(--parchment-edge);
  }
</style>
