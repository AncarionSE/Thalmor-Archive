---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ReportList from '../../components/ReportList.astro';
import { CATEGORY_MAP } from '../../lib/categories';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  const byCategory = new Map<string, typeof reports>();
  for (const r of reports) {
    const key = r.id.split('/')[0];
    if (!byCategory.has(key)) byCategory.set(key, []);
    byCategory.get(key)!.push(r);
  }
  return [...byCategory.entries()].map(([key, reports]) => ({
    params: { category: key },
    props: { reports: reports.sort((a, b) => b.data.order - a.data.order) },
  }));
}

const { category } = Astro.params;
const { reports } = Astro.props;
const meta = CATEGORY_MAP.get(category!);
const label = meta?.label.replace(/&amp;/g, '&') ?? category;
---
<Base title={`${label} — Canonreeve Archives`} description={`Filed ${label.toLowerCase()} of the Canonreeve Archives.`}>
  <main class="desk">
    <section class="ledger parchment" aria-label={`${label} volume`}>
      <a class="return" href={import.meta.env.BASE_URL}>&larr; Return to the shelf</a>
      <header class="masthead">
        <p class="over">Canonreeve Archives</p>
        <h1>{label}</h1>
        <div class="ornament" aria-hidden="true">
          <svg width="26" height="10" viewBox="0 0 26 10" fill="currentColor"><path d="M13 0l3.2 5L13 10 9.8 5 13 0zm-9 3.4L6.4 5 4 6.6 1.6 5 4 3.4zm18 0L24.4 5 22 6.6 19.6 5 22 3.4z"/></svg>
        </div>
      </header>

      <ReportList reports={reports} />

      <footer class="colophon">Filed and bound by order of the Canonreeve.</footer>
    </section>
  </main>
</Base>

<style>
  .desk {
    min-height: 100vh;
    display: grid; place-items: center;
    padding: 3rem 1rem;
  }
  .ledger {
    width: min(680px, 94vw);
    padding: clamp(1.6rem, 4vw, 3.2rem);
    border-radius: 4px;
    box-shadow: 0 30px 50px rgba(0,0,0,.6), inset 0 0 46px rgba(94,66,28,.35);
  }
  .return {
    display: inline-block; margin-bottom: 1.2rem;
    font-family: var(--font-caps); font-size: .9rem; letter-spacing: .08em;
    color: var(--ink-faded); text-decoration: none;
    position: relative; z-index: 1;
  }
  .return:hover { color: var(--seal); }
  .masthead { text-align: center; position: relative; z-index: 1; }
  .over {
    font-family: var(--font-caps); letter-spacing: .3em; font-size: .8rem;
    color: var(--ink-faded); margin: 0 0 .4rem;
  }
  h1 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.6rem, 4vw, 2.2rem); letter-spacing: .06em;
    margin: 0 0 .6rem; color: var(--ink);
  }
  .masthead .ornament { justify-content: center; color: var(--gold); }

  .colophon {
    margin-top: 2rem; text-align: center; font-style: italic;
    color: var(--ink-faded); position: relative; z-index: 1;
  }
</style>
